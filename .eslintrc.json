{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-undef": "off",
    "no-unused-vars": ["warn", {
      "vars": "all",
      "args": "after-used",
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrors": "none"
    }],
    "no-console": "off",
    "no-prototype-builtins": "off",
    "no-empty": "off",
    "no-cond-assign": ["warn", "except-parens"],
    "eqeqeq": ["warn", "smart"],

    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-self-compare": "error",
    "no-unsafe-optional-chaining": "error",
    "no-shadow-restricted-names": "error",
    "no-template-curly-in-string": "warn",
    "no-unreachable-loop": "warn",
    "no-useless-backreference": "warn",
    "no-fallthrough": "warn"
  },
  "globals": {
    "firebase": "readonly"
  },
  "overrides": [
    {
      "files": ["src/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["js/*.js", "sw.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["tools/**/*.js"],
      "env": { "node": true, "browser": false },
      "rules": {
        "no-new-func": "off"
      }
    },
    {
      "files": ["functions/**/*.js"],
      "env": { "node": true, "browser": false }
    }
  ]
}
