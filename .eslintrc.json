{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "serviceworker": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-prototype-builtins": "off",
    "no-empty": "off",
    "no-cond-assign": ["warn", "except-parens"],
    "eqeqeq": ["warn", "smart"]
  },
  "globals": {
    "firebase": "readonly"
  },
  "overrides": [
    {
      "files": ["src/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
