кат":1,"в":1,"течен":1,"всег":1,"игровог":1,"сезон":1},"len":171},{"src":0,"page":1,"text":"1.2. Для игры на поле требуется действующий членский билет клуба либо разовый билет на игру (грин-фи). Для участия в турнирах дополнительно требуется действующий гандикап WHS.","tf":{"1":1,"2":1,"для":2,"игр":2,"на":2,"пол":1,"требуетс":2,"действующ":2,"членск":1,"билет":2,"клуб":1,"либ":1,"разов":1,"гринфи":1,"участи":1,"в":1,"турнир":1,"дополнительн":1,"гандикап":2},"len":175},{"src":0,"page":1,"text":"1.3. Игрок обязан знать и соблюдать Правила гольфа, утверждённые R&A и USGA, а также местные правила клуба.","tf":{"1":1,"3":1,"игрок":1,"обязан":1,"знат":1,"и":2,"соблюдат":1,"правил":2,"гольф":1,"утвержденн":1,"r":1,"a":1,"usga":1,"а":1,"такж":1,"местн":1,"клуб":1},"len":107},{"src":0,"page":1,"text":"2. Бронирование и время старта","tf":{"2":1,"бронирование":1,"и":1,"врем":1,"старт":1},"len":30},{"src":0,"page":1,"text":"2.1. Бронирование времени тей-тайма открывается за 7 дней до даты игры и закрывается за 1 час до стартового времени.","tf":{"1":2,"2":1,"7":1,"бронирование":1,"времен":2,"тейтайм":1,"открываетс":1,"за":2,"дне":1,"до":2,"дат":1,"игр":1,"и":1,"закрываетс":1,"час":1,"стартовог":1},"len":116},{"src":0,"page":1,"text":"• Отмена брони возможна не позднее чем за 24 часа до старта — без штрафа.","tf":{"24":1,"отмена":1,"бронирование":1,"возможн":1,"не":1,"поздн":1,"чем":1,"за":1,"час":1,"до":1,"старт":1,"без":1,"штраф":1},"len":73},{"src":0,"page":1,"text":"• Отмена позднее чем за 24 часа влечёт штраф в размере 50% стоимости грин-фи.","tf":{"24":1,"50":1,"отмена":1,"поздн":1,"чем":1,"за":1,"час":1,"влечет":1,"штраф":1,"в":1,"размер":1,"стоимость":1,"гринфи":1},"len":77},{"src":0,"page":1,"text":"• Неявка без предупреждения (no-show) фиксируется в протоколе клуба.","tf":{"неявк":1,"без":1,"предупреждени":1,"noshow":1,"фиксируетс":1,"в":1,"протокол":1,"клуб":1},"len":68},{"src":0,"page":1,"text":"2.2. Игрок обязан явиться на первый ти не позднее чем за 10 минут до назначенного времени старта.","tf":{"2":2,"10":1,"игрок":1,"обязан":1,"явитьс":1,"на":1,"перв":1,"ти":1,"не":1,"поздн":1,"чем":1,"за":1,"минут":1,"до":1,"назначенног":1,"времен":1,"старт":1},"len":97},{"src":0,"page":1,"text":"3. Гандикап и WHS (World Handicap System)","tf":{"3":1,"гандикап":2,"и":1,"world":1,"handicap":1,"system":1},"len":41},{"src":0,"page":1,"text":"3.1. Все игроки клуба ведут личный гандикап в системе World Handicap System (WHS). Расчёт гандикапа производится по последним 20 сыгранным раундам.","tf":{"1":1,"3":1,"20":1,"все":1,"игрок":1,"клуб":1,"ведут":1,"личн":1,"гандикап":3,"в":1,"систем":1,"world":1,"handicap":1,"system":1,"расчет":1,"производитс":1,"по":1,"последн":1,"сыгранн":1,"раунд":1},"len":147},{"src":0,"page":1,"text":"3.2. Минимальное значение гандикапа — минус 10, максимальное — плюс","tf":{"2":1,"3":1,"10":1,"минимальн":1,"значен":1,"гандикап":1,"минус":1,"максимальн":1,"плюс":1},"len":67},{"src":0,"page":1,"text":"54. Гандикап пересчитывается автоматически после каждого результативного раунда.","tf":{"54":1,"гандикап":1,"пересчитываетс":1,"автоматическ":1,"посл":1,"каждог":1,"результативног":1,"раунд":1},"len":80},{"src":0,"page":1,"text":"3.3. Для участия в турнирах клубного зачёта игрок должен предоставить актуальный гандикап. Неточный гандикап может привести к дисквалификации.","tf":{"3":2,"для":1,"участи":1,"в":1,"турнир":1,"клубног":1,"зачет":1,"игрок":1,"должен":1,"предоставит":1,"актуальн":1,"гандикап":2,"неточн":1,"может":1,"привест":1,"к":1,"дисквалификаци":1},"len":142},{"src":0,"page":1,"text":"• Официальные раунды вносятся в систему в течение 24 часов после игры.","tf":{"24":1,"официальн":1,"раунд":1,"вносятс":1,"в":2,"систем":1,"течен":1,"час":1,"посл":1,"игр":1},"len":70},{"src":0,"page":1,"text":"• Раунды, сыгранные с нарушением правил, в расчёт гандикапа не включаются.","tf":{"раунд":1,"сыгранн":1,"с":1,"нарушен":1,"правил":1,"в":1,"расчет":1,"гандикап":1,"не":1,"включаютс":1},"len":74},{"src":0,"page":1,"text":"4. Правила темпа игры","tf":{"4":1,"правил":1,"темп":1,"игр":1},"len":21},{"src":0,"page":2,"text":"4.1. Максимальное время на прохождение 18 лунок для группы из четырёх игроков составляет 4 часа 20 минут.","tf":{"1":1,"4":2,"18":1,"20":1,"максимальн":1,"врем":1,"на":1,"прохожден":1,"лунок":1,"для":1,"групп":1,"из":1,"четырех":1,"игрок":1,"составляет":1,"час":1,"минут":1},"len":105},{"src":0,"page":2,"text":"4.2. Группа, отставшая от впереди идущей группы более чем на одну лунку, обязана пропустить её вперёд (играть «через» игру, ready golf).","tf":{"2":1,"4":1,"групп":2,"отставш":1,"от":1,"вперед":2,"идущ":1,"бол":1,"чем":1,"на":1,"одн":1,"лунк":1,"обязан":1,"пропустит":1,"ее":1,"играт":1,"через":1,"игр":1,"ready":1,"golf":1},"len":136},{"src":0,"page":2,"text":"• Подготовка к удару — не более 45 секунд.","tf":{"45":1,"подготовк":1,"к":1,"удар":1,"не":1,"бол":1,"секунд":1},"len":42},{"src":0,"page":2,"text":"• Поиск мяча — не более 3 минут.","tf":{"3":1,"поиск":1,"мяч":1,"не":1,"бол":1,"минут":1},"len":32},{"src":0,"page":2,"text":"4.3. Судьи и маршалы клуба уполномочены контролировать темп игры и выносить предупреждения.","tf":{"3":1,"4":1,"судь":1,"и":2,"маршал":1,"клуб":1,"уполномочен":1,"контролироват":1,"темп":1,"игр":1,"выносит":1,"предупреждени":1},"len":91},{"src":0,"page":2,"text":"5. Дресс-код","tf":{"5":1,"дрескод":1},"len":12},{"src":0,"page":2,"text":"5.1. На территории клуба действует дресс-код. Игрокам и гостям следует соблюдать следующие требования:","tf":{"1":1,"5":1,"на":1,"территори":1,"клуб":1,"действует":1,"дрескод":1,"игрок":1,"и":1,"гост":1,"следует":1,"соблюдат":1,"следующ":1,"требовани":1},"len":102},{"src":0,"page":2,"text":"• Головной убор рекомендуется, особенно в солнечную погоду.","tf":{"головн":1,"убор":1,"рекомендуетс":1,"особенн":1,"в":1,"солнечную":1,"погод":1},"len":59},{"src":0,"page":2,"text":"• Игровая обувь — гольф-обувь без металлических шипов.","tf":{"игров":1,"обув":1,"гольфобув":1,"без":1,"металлическ":1,"шип":1},"len":54},{"src":0,"page":2,"text":"• Футболки с рукавом; майки, шорты без ремня и пляжная обувь не допускаются.","tf":{"футболк":1,"с":1,"рукав":1,"майк":1,"шорт":1,"без":1,"ремн":1,"и":1,"пляжн":1,"обув":1,"не":1,"допускаютс":1},"len":76},{"src":0,"page":2,"text":"6. Электронная счётная карточка","tf":{"6":1,"электронн":1,"скоринг":1,"карточк":1},"len":31},{"src":0,"page":2,"text":"6.1. Клуб использует электронную счётную карточку (лайв-скоринг). Результаты заносятся в приложение после каждой лунки.","tf":{"1":1,"6":1,"клуб":1,"использует":1,"электронную":1,"счетную":1,"карточк":1,"скоринг":1,"результат":1,"заносятс":1,"в":1,"приложен":1,"посл":1,"кажд":1,"лунк":1},"len":119},{"src":0,"page":2,"text":"6.2. Карточка считается подтверждённой после того, как её подписали маркер и игрок. Внесение изменений после подтверждения запрещено.","tf":{"2":1,"6":1,"карточк":1,"считаетс":1,"подтвержденн":1,"посл":2,"тог":1,"как":1,"ее":1,"подписал":1,"маркер":1,"и":1,"игрок":1,"внесен":1,"изменен":1,"подтверждени":1,"запрещен":1},"len":133},{"src":0,"page":2,"text":"6.3. Результаты электронной карточки автоматически загружаются в систему гандикапа WHS.","tf":{"3":1,"6":1,"результат":1,"электронн":1,"карточк":1,"автоматическ":1,"загружаютс":1,"в":1,"систем":1,"гандикап":2},"len":87},{"src":0,"page":2,"text":"7. Гости и грин-фи","tf":{"7":1,"гост":1,"и":1,"гринфи":1},"len":18},{"src":0,"page":2,"text":"7.1. Гриными могут пользоваться только игроки, имеющие действующий билет на игру.","tf":{"1":1,"7":1,"гриным":1,"могут":1,"пользоватьс":1,"тольк":1,"игрок":1,"имеющ":1,"действующ":1,"билет":1,"на":1,"игр":1},"len":81},{"src":0,"page":2,"text":"7.2. Стоимость грин-фи зависит от дня недели и времени старта. Актуальные цены публикуются на сайте клуба.","tf":{"2":1,"7":1,"стоимость":2,"гринфи":1,"зависит":1,"от":1,"дня":1,"недел":1,"и":1,"времен":1,"старт":1,"актуальн":1,"публикуютс":1,"на":1,"сайт":1,"клуб":1},"len":106},{"src":0,"page":2,"text":"7.3. Дети до 7 лет допускаются на поле только в сопровождении взрослого игрока.","tf":{"3":1,"7":2,"дет":1,"до":1,"лет":1,"допускаютс":1,"на":1,"пол":1,"тольк":1,"в":1,"сопровождени":1,"взрослог":1,"игрок":1},"len":79},{"src":0,"page":2,"text":"8. Ответственность","tf":{"8":1,"ответственност":1},"len":18},{"src":0,"page":2,"text":"8.1. Клуб не несёт ответственности за утерянное или повреждённое имущество игроков, оставленное на территории клуба.","tf":{"1":1,"8":1,"клуб":2,"не":1,"несет":1,"ответственност":1,"за":1,"утерянн":1,"или":1,"поврежденн":1,"имуществ":1,"игрок":1,"оставленн":1,"на":1,"территори":1},"len":116},{"src":0,"page":2,"text":"8.2. Игроки обязаны соблюдать технику безопасности и бережно относиться к покрытию поля. Порча дерна и грина запрещена.","tf":{"2":1,"8":1,"игрок":1,"обязан":1,"соблюдат":1,"техник":1,"безопасност":1,"и":2,"бережн":1,"относитьс":1,"к":1,"покрытию":1,"пол":1,"порч":1,"дерн":1,"грин":1,"запрещен":1},"len":119},{"src":0,"page":3,"text":"Если остались вопросы, обратитесь к администратору клуба или задайте их в разделе «Помощник» на сайте.","tf":{"есл":1,"осталис":1,"вопрос":1,"обратитес":1,"к":1,"администратор":1,"клуб":1,"или":1,"задайт":1,"их":1,"в":1,"раздел":1,"помощник":1,"на":1,"сайт":1},"len":102}]}