{
    "name": "pestovo-livescoring",
    "version": "1.122.0",
    "private": true,
    "description": "Pestovo Live Scoring — static web app + Firebase Cloud Functions",
    "scripts": {
        "test": "node tools/run-tests.js",
        "test:ci": "node tools/run-tests.js --ci",
        "lint:syntax": "node tools/syntax-check.js",
        "lint": "eslint js src tools functions sw.js --ext .js",
        "check:globals": "node tools/check-unused-globals.js",
        "check:listeners": "node tools/check-rtdb-listeners.js",
        "check:fonts": "node tools/build-fontawesome.js --check",
        "check:design": "node tools/test-design-tokens.js",
        "assets": "node tools/rev-assets.js",
        "dev": "vite",
        "build": "vite build",
        "build:public": "node tools/build-public.js",
        "build:fonts": "node tools/build-fontawesome.js",
        "preview": "vite preview",
        "check:bundle": "node tools/check-bundle.js",
        "check:browser": "node tools/browser-check.js",
        "check:scorecards": "node tools/check-scorecard-mobile.js && node tools/check-score-entry-mobile.js && node tools/check-scoring-header-mobile.js && node tools/check-printcards-preview.js && node tools/check-entry-scorecards.js",
        "check:nav": "node tools/check-nav-mobile.js",
        "check:round-setup-mobile": "node tools/check-round-setup-mobile.js",
        "check:tournaments-mobile": "node tools/check-tournaments-display-mobile.js",
        "check:admin-display-mobile": "node tools/check-display-settings-mobile.js",
        "check:display-mobile": "node tools/check-round-setup-mobile.js && node tools/check-tournaments-display-mobile.js && node tools/check-display-settings-mobile.js",
        "check:printcards": "node tools/check-printcards-preview.js",
        "check:entry-scorecards": "node tools/check-entry-scorecards.js",
        "check:scorecard-pwa": "node tools/check-scorecard-realtime-pwa.js"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "6.5.0",
        "@sparticuz/chromium": "^131.0.0",
        "esbuild": "0.21.5",
        "eslint": "^8.57.0",
        "jsdom": "^30.1.2",
        "playwright": "^1.49.1",
        "prettier": "^3.2.5",
        "subset-font": "2.3.0",
        "vite": "^5.4.21"
    }
}
